# ============================================
# SAL DO REAA — ambiente de PRODUÇÃO (VPS Contabo)
# ============================================
# Uso:
#   cp .env.production.example .env
#   # edite TODOS os valores marcados com TROQUE
#   docker compose up -d --build
#
# NUNCA versione o .env real. Este arquivo é apenas um modelo.
# O Compose monta a DATABASE_URL a partir de DB_*; a senha do banco deve
# conter apenas letras/números (ou ser percent-encoded se tiver símbolos).

# ============================================
# Django
# ============================================
DJANGO_DEBUG=False
DJANGO_SETTINGS_MODULE=core.settings

# Gere cada segredo separadamente:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=TROQUE_DJANGO_SECRET_KEY_64_CHARS
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=TROQUE_JWT_SECRET_48_CHARS
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CRYPTO_KEY=TROQUE_CRYPTO_KEY_48_CHARS

# ============================================
# Domínio / SEO / Segurança
# ============================================
SEO_SITE_URL=https://saldoreaa.cloud
BASE_URL=https://saldoreaa.cloud
DJANGO_ALLOWED_HOSTS=saldoreaa.cloud,www.saldoreaa.cloud,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://saldoreaa.cloud,https://www.saldoreaa.cloud

# 0 = o Nginx/Caddy do host faz o redirect http -> https.
# 1 = o próprio Django também redireciona (use se não houver proxy).
DJANGO_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=31536000

# ============================================
# PostgreSQL (container db)
# ============================================
DB_NAME=saldabritanea
DB_USER=gprbr
# Troque por uma senha longa, só com letras e números.
DB_PASSWORD=TROQUEsenhafortesoalfanumerica
# Porta publicada apenas em 127.0.0.1 (o app usa a rede interna do Docker).
DB_PORT=5432

# ============================================
# Redis (container redis)
# ============================================
# Porta publicada apenas em 127.0.0.1.
REDIS_PORT=6379

# ============================================
# Portas do host
# ============================================
# Nginx/Caddy do host deve apontar para http://127.0.0.1:8111
APP_PORT=8111
# Só têm efeito se você usar o perfil `nginx` do Compose.
NGINX_PORT=80
NGINX_HTTPS_PORT=443

# ============================================
# Cloudflare Turnstile (obrigatório no login)
# ============================================
# Painel Cloudflare -> Turnstile -> Site/Secret key.
CLOUDFLARE_TURNSTILE_SITE_KEY=TROQUE_SITE_KEY
CLOUDFLARE_TURNSTILE_SECRET_KEY=TROQUE_SECRET_KEY

# ============================================
# E-mail (opcional, mas necessário para convites/lembretes)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=SAL DO REAA <nao-responder@saldoreaa.cloud>

# Vazio = envia aos membros de verdade.
# Preenchido = modo de teste: TODA notificação vai só para este e-mail.
EVENTO_EMAIL_PARA_TESTE=

# ============================================
# Tenant
# ============================================
GPRB_TENANT_CODE=SCG33REAA
GPRB_TENANT_ID=
GPRB_TENANT_NAME=
VALE_NOME=Jacarepaguá

# ============================================
# Google Calendar (opcional)
# ============================================
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_WORKSPACE_ADMIN=admin@seudominio.com
# GOOGLE_RANKING_CALENDAR_ID=

# ============================================
# Sentry (opcional)
# ============================================
# SENTRY_DSN=

# ============================================
# Checklist antes de subir
# ============================================
# [ ] Troquei DJANGO_SECRET_KEY, JWT_SECRET, CRYPTO_KEY e DB_PASSWORD
# [ ] Configurei as chaves reais do Turnstile
# [ ] O DNS de saldoreaa.cloud aponta para o IP da VPS
# [ ] O firewall libera apenas 22, 80 e 443
# [ ] PostgreSQL e Redis não estão expostos na internet (loopback)
# [ ] HTTPS funcionando antes de manter HSTS em 31536000
