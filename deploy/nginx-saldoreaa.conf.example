# ============================================
# Nginx do HOST (Contabo) — saldoreaa.cloud
# ============================================
# 1. Copie para /etc/nginx/sites-available/saldoreaa.cloud
# 2. Ajuste o caminho do media abaixo.
# 3. ln -s /etc/nginx/sites-available/saldoreaa.cloud /etc/nginx/sites-enabled/
# 4. nginx -t && systemctl reload nginx
# 5. sudo certbot --nginx -d saldoreaa.cloud
#
# O app roda em Docker e escuta somente em 127.0.0.1:8111.
# Static files são servidos pelo WhiteNoise (proxy); media vem do volume ./media.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name saldoreaa.cloud www.saldoreaa.cloud;

    # Certbot pode gerenciar este redirect automaticamente.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name saldoreaa.cloud www.saldoreaa.cloud;

    ssl_certificate     /etc/letsencrypt/live/saldoreaa.cloud/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/saldoreaa.cloud/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 25m;
    server_tokens off;

    # Uploads (fotos, comprovantes, quitações).
    location /media/ {
        # Troque pelo caminho real do repositório na VPS.
        alias /opt/saldoreaa/media/;
        expires 7d;
        add_header Cache-Control "public";
    }

    # Django + FastAPI (WhiteNoise serve /static/).
    location / {
        proxy_pass http://127.0.0.1:8111;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 60s;
    }

    # Healthcheck (não precisa ficar público, mas é útil para monitoração).
    location = /healthz/ {
        proxy_pass http://127.0.0.1:8111/healthz/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        access_log off;
    }
}
