# ============================================
# GPRBR CRM - Variáveis de Ambiente (desenvolvimento/local)
# ============================================
# Copie este arquivo para .env e edite os valores.
# Para a VPS Contabo, use .env.production.example.

# ============================================
# Django
# ============================================
# Chave secreta (gerar com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=change-this-in-production-use-long-random-string

# Segredos da API/JWT e criptografia de segredos (obrigatórios em produção)
JWT_SECRET=change-this-jwt-secret-use-long-random-string
CRYPTO_KEY=

# Modo debug (DEVE ser False em produção)
DJANGO_DEBUG=False

# Settings module
DJANGO_SETTINGS_MODULE=core.settings

# Dominio canonico publico, sem barra no final (ex.: https://crm.sc33.org.br).
# Usado em canonical, Open Graph, Twitter Cards, sitemap.xml e robots.txt.
SEO_SITE_URL=https://saldoreaa.cloud

# ============================================
# Database - PostgreSQL
# ============================================
DB_NAME=saldabritanea
DB_USER=gprbr
DB_PASSWORD=securepassword123
DB_HOST=db
DB_PORT=5432

# URL completa do banco (usado pelo Django)
DATABASE_URL=postgresql://gprbr:securepassword123@db:5432/saldabritanea

# ============================================
# Redis
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ============================================
# Aplicação
# ============================================
APP_PORT=8111
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,saldoreaa.cloud,www.saldoreaa.cloud
CSRF_TRUSTED_ORIGINS=http://localhost:8111,http://127.0.0.1:8111,https://saldoreaa.cloud,https://www.saldoreaa.cloud
# Base usada nos links de e-mail (RSVP/convites).
BASE_URL=http://localhost:8111

# ============================================
# Locust - Teste de carga (opcional)
# ============================================
# Conta de teste do CRM; use somente uma conta descartável/de teste.
LOCUST_USERNAME=
LOCUST_PASSWORD=
LOCUST_TARGET_URL=http://app:8111
LOCUST_PORT=8089

# CORS (para API)
CORS_ALLOWED_ORIGINS=*

# ============================================
# Email (opcional)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-app
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=noreply@gprbr.com.br
# Em desenvolvimento, redireciona todas as notificações para este e-mail.
# Deixe vazio em produção para enviar aos membros.
EVENTO_EMAIL_PARA_TESTE=seu-email@exemplo.com

# ============================================
# Agenda — Google Calendar + lembretes (opcional)
# ============================================
# Service Account com delegação no Workspace (JSON inline ou caminho de arquivo).
GOOGLE_SERVICE_ACCOUNT_JSON=
# E-mail administrador do Workspace para impersonação (opcional).
GOOGLE_WORKSPACE_ADMIN=
# Por tenant: preencher em acesso.Tenant.google_calendar_id (setup/admin).
# Auto-sync do ranking (eventos por loja): calendário único de destino.
# Vazio = sync desligado (eventos salvam só no CRM).
GOOGLE_RANKING_CALENDAR_ID=

# Cloudflare Turnstile. Em DEBUG, ambos vazios ativam as chaves oficiais de teste.
# Em produção, configure as chaves reais do painel Cloudflare.
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# ============================================
# Tenant GPRB
# ============================================
GPRB_TENANT_ID=
GPRB_TENANT_NAME=
GPRB_TENANT_CODE=SCG33REAA

# ============================================
# Superusuário (opcional, para criação automática)
# ============================================
CREATE_SUPERUSER=False
SUPERUSER_EMAIL=admin@gprbr.com.br
SUPERUSER_PASSWORD=admin123

# Token válido para a conta/site de teste usada pelo Locust.
LOCUST_TURNSTILE_TOKEN=

# ============================================
# Segurança - HTTPS
# ============================================
# 0 = o proxy (Nginx/Caddy) faz o redirect http -> https.
# 1 = o próprio Django também redireciona.
DJANGO_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=31536000

# ============================================
# Logs
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/gprbr.log
