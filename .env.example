# =============================================================================
# CronosCRM — variaveis de ambiente.
# Em dev: copie para `.env` na raiz do projeto.
# No Railway: defina em Variables (o servico Postgres injeta DATABASE_URL).
# Obrigatorias em producao (sem elas o app nao sobe — fail-fast): [REQ]
# =============================================================================

# ---------------------------------------------------------------------------
# Django — SEGREDOS [REQ em producao]
# Gere com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=troque-por-um-segredo-longo-e-aleatorio
JWT_SECRET=troque-por-outro-segredo-longo-e-aleatorio
# CRYPTO_KEY=opcional-mas-recomendado-para-isolar-a-cifra-de-segredos
# Redireciona http -> https em producao. OFF por padrao (HSTS + edge do Railway
# cobrem); ative apenas se o healthcheck continuar respondendo 200.
# DJANGO_SSL_REDIRECT=1

# ---------------------------------------------------------------------------
# Hosts — o Railway gera um dominio *.up.railway.app (aceito por padrao).
# Se usar dominio proprio, defina as duas linhas abaixo:
# ---------------------------------------------------------------------------
# DJANGO_ALLOWED_HOSTS=meusite.com.br,www.meusite.com.br
# CSRF_TRUSTED_ORIGINS=https://meusite.com.br,https://www.meusite.com.br

# ---------------------------------------------------------------------------
# Banco PostgreSQL — no Railway a variavel DATABASE_URL e injetada
# automaticamente pelo servico Postgres. Em dev, use as variaveis PG*:
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://usuario:senha@host:5432/nomedobanco
# PGDATABASE=esferacrm
# PGUSER=postgres
# PGPASSWORD=
# PGHOST=localhost
# PGPORT=5432

# ---------------------------------------------------------------------------
# E-mail (opcional — sem EMAIL_HOST o envio roda em modo simulacao)
# ---------------------------------------------------------------------------
# EMAIL_HOST=smtp.exemplo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=CRM <nao-responder@meusite.com.br>
